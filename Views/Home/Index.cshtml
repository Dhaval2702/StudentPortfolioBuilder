@model HomePageViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="row g-3 align-items-stretch mb-3">
    <div class="col-lg-9">
        <section class="hero-v2 p-4 rounded-4 h-100">
            <h1 class="hero-title mb-2">Welcome, Future Professionals! 🚀</h1>
            <h2 class="hero-sub mb-3">Build Your Portfolio &amp; Get Discovered by Top Employers</h2>
            <div class="d-flex gap-2">
                <a class="btn btn-gradient btn-lg" asp-controller="Home" asp-action="Register">Create My Portfolio</a>
                <a class="btn btn-outline-light btn-lg" href="#browse-profiles">Explore Profiles</a>
            </div>
            <div class="stats-strip mt-4">
                <div><strong>@Model.TotalCount+</strong><span>Student Profiles</span></div>
                <div><strong>@Model.JobCount+</strong><span>Job Offers</span></div>
                <div><strong>@Model.RecruiterCount+</strong><span>Recruiters</span></div>
                <div><strong>@Model.CategoryCounts.Count+</strong><span>Fields</span></div>
            </div>
        </section>
    </div>
    <div class="col-lg-3">
        <section class="panel-card h-100">
            <h4 class="fw-bold mb-3">Find Your Field</h4>
            <form method="get" asp-action="Index" class="d-grid gap-2">
                <input asp-for="Filters.Name" class="form-control" placeholder="Search student" />
                <select asp-for="Filters.FieldOfStudy" asp-items="Model.FieldsOfStudy" class="form-select">
                    <option value="">All Fields</option>
                </select>
                <select asp-for="Filters.JobRole" asp-items="Model.JobRoles" class="form-select">
                    <option value="">All Roles</option>
                </select>
                <button class="btn btn-gradient">Search</button>
            </form>
        </section>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-9">
        <h3 class="section-title-sm d-flex justify-content-between">Featured Profiles <a asp-controller="Home" asp-action="Index" class="small text-decoration-none">View All</a></h3>
        <div class="row g-3">
            @foreach (var p in Model.FeaturedProfiles)
            {
                <div class="col-md-6 col-xl-3">
                    <div class="card profile-tile h-100">
                        <img src="@(p.ImagePath ?? "/images/default-avatar.svg")" class="tile-img" alt="@p.Name" />
                        <div class="card-body p-2">
                            <div class="fw-bold">@p.Name</div>
                            <div class="small text-muted">@p.FieldOfStudy</div>
                            <div class="small">@p.JobRole</div>
                            <a asp-action="Profile" asp-route-id="@p.Id" class="btn btn-sm btn-primary w-100 mt-2">View</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-3">
        <h3 class="section-title-sm d-flex justify-content-between">Top Recruiters <span class="small text-primary">View All</span></h3>
        <div class="panel-card">
            @foreach (var c in Model.TopCompanies)
            {
                <div class="d-flex justify-content-between border-bottom py-2"><span>@c.Name</span><span class="text-muted small">@c.Industry</span></div>
            }
        </div>
    </div>
</div>

<div class="row g-3" id="browse-profiles">
    <div class="col-lg-6">
        <h3 class="section-title-sm">Browse by Category</h3>
        <div class="panel-card">
            @foreach (var cat in Model.CategoryCounts)
            {
                <div class="d-flex justify-content-between border-bottom py-2"><span>@cat.Key</span><span>@cat.Value + Profiles</span></div>
            }
        </div>
    </div>
    <div class="col-lg-6">
        <h3 class="section-title-sm">Recent Placements</h3>
        <div class="panel-card">
            @foreach (var job in Model.TrendingJobs)
            {
                <div class="d-flex justify-content-between border-bottom py-2">
                    <div>
                        <div class="fw-semibold">@job.Title</div>
                        <div class="small text-muted">@job.Company?.Name - @job.Location</div>
                    </div>
                    <span class="badge bg-primary">@job.Openings Open</span>
                </div>
            }
        </div>
    </div>
</div>
