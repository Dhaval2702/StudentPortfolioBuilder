@model HomePageViewModel
@{ ViewData["Title"] = "Home"; }

<div class="row g-3">
    <div class="col-lg-3">
        <div class="filter-side p-3 rounded-4 h-100">
            <h4 class="text-white mb-3">Find Talent by</h4>
            <form method="get" asp-action="Index" class="d-grid gap-2">
                <input asp-for="Filters.Name" class="form-control" placeholder="Search Roles..." />
                <select asp-for="Filters.FieldOfStudy" asp-items="Model.FieldsOfStudy" class="form-select"><option value="">All Fields</option></select>
                <select asp-for="Filters.JobRole" asp-items="Model.JobRoles" class="form-select"><option value="">All Roles</option></select>
                <button class="btn btn-light fw-semibold">Apply Filters</button>
            </form>
        </div>
    </div>

    <div class="col-lg-9">
        <section class="hero-v2 p-4 rounded-4 mb-3">
            <h2 class="hero-sub">Showcase Your Skills & Kickstart Your Career!</h2>
            <a class="btn btn-light btn-lg mt-2" asp-action="Register">Create Your Portfolio</a>
        </section>

        <div class="stats-strip mb-3">
            <div><strong>@Model.TotalCount+</strong><span>Students</span></div>
            <div><strong>@Model.CategoryCounts.Count+</strong><span>Colleges</span></div>
            <div><strong>@Model.RecruiterCount+</strong><span>Recruiters</span></div>
            <div><strong>@Model.JobCount+</strong><span>Jobs Posted</span></div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h3 class="section-title-sm mb-0">Featured Student Profiles</h3>
            <a asp-action="Profiles" class="btn btn-sm btn-outline-primary">View All Profiles</a>
        </div>
        <div class="row g-3 mb-3">
            @foreach (var p in Model.FeaturedProfiles)
            {
                <div class="col-md-6 col-xl-3">
                    <div class="card profile-tile h-100 @(p.IsTopRated ? "top-rated" : string.Empty)">
                        <img src="@(p.ImagePath ?? "/images/default-avatar.svg")" class="tile-img" alt="@p.Name" />
                        <div class="card-body p-2">
                            <div class="d-flex justify-content-between">
                                <div class="fw-bold">@p.Name</div>
                                <span class="badge bg-warning text-dark">@p.Cgpa</span>
                            </div>
                            <div class="small text-muted">@p.JobRole</div>
                            <div class="small">@p.CollegeName</div>
                            @if (p.IsTopRated)
                            {
                                <div><span class="badge bg-success mt-1">Top Rated</span></div>
                            }
                            <a asp-action="Profile" asp-route-id="@p.Id" class="btn btn-sm btn-primary w-100 mt-2">View Profile</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <h4 class="section-title-sm">Browse by Category</h4>
                <div class="panel-card">
                    @foreach (var cat in Model.CategoryCounts)
                    {
                        <div class="d-flex justify-content-between py-1 border-bottom"><span>@cat.Key</span><span>@cat.Value + Profiles</span></div>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <h4 class="section-title-sm">Recent Placements</h4>
                <div class="panel-card">
                    @foreach (var j in Model.TrendingJobs)
                    {
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <div><div>@j.Title</div><small class="text-muted">@j.Company?.Name - @j.Location</small></div>
                            <span class="badge bg-primary">@j.Openings Open</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
