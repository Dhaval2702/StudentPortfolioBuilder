@model HomePageViewModel
@{ ViewData["Title"] = "Home"; }

<div class="row g-3">
    <div class="col-xl-3">
        <aside class="filter-side p-3 rounded-4 h-100">
            <h4 class="text-white fw-bold mb-3">⋯ Find Talent by ⋯</h4>
            <form method="get" asp-action="Index" class="d-grid gap-2 mb-3">
                <input asp-for="Filters.Name" class="form-control" placeholder="Search Roles..." />
                <select asp-for="Filters.FieldOfStudy" asp-items="Model.FieldsOfStudy" class="form-select"><option value="">All Fields</option></select>
                <select asp-for="Filters.JobRole" asp-items="Model.JobRoles" class="form-select"><option value="">All Roles</option></select>
                <button class="btn btn-light fw-semibold">Apply Filters</button>
            </form>

            <div class="text-white-50 small mb-2">Categories</div>
            <div class="d-grid gap-2">
                @foreach (var cat in Model.CategoryCounts.Take(8))
                {
                    <a asp-action="Index" asp-route-fieldOfStudy="@cat.Key" class="side-pill d-flex justify-content-between text-decoration-none">
                        <span><i class="bi bi-grid-3x3-gap-fill me-1"></i>@cat.Key</span>
                        <span class="text-info">●</span>
                    </a>
                }
            </div>
        </aside>
    </div>

    <div class="col-xl-9">
        <section class="hero-v2 p-4 rounded-4 mb-3">
            <div class="hero-content-wrap">
                <h2 class="hero-sub mb-2">Kickstart Your Career with<br />a Powerful Student <span>Portfolio!</span></h2>
                <div class="d-flex flex-wrap gap-3 mt-3">
                    <a class="btn btn-hero btn-lg" asp-action="Register">Create Your Profile</a>
                    <a class="btn btn-watch btn-lg" href="#featuredProfiles"><i class="bi bi-play-circle me-1"></i>Watch Video</a>
                </div>
            </div>
        </section>

        <div class="stats-strip mb-3">
            <div class="stat-card students"><div class="stat-content"><span class="stat-icon"><i class="bi bi-people-fill"></i></span><div><strong>@Model.TotalCount+</strong><span>Students</span></div></div></div>
            <div class="stat-card colleges"><div class="stat-content"><span class="stat-icon"><i class="bi bi-bank2"></i></span><div><strong>@Model.CategoryCounts.Count+</strong><span>Colleges</span></div></div></div>
            <div class="stat-card recruiters"><div class="stat-content"><span class="stat-icon"><i class="bi bi-person-workspace"></i></span><div><strong>@Model.RecruiterCount+</strong><span>Recruiters</span></div></div></div>
            <div class="stat-card jobs"><div class="stat-content"><span class="stat-icon"><i class="bi bi-journal-text"></i></span><div><strong>@Model.JobCount+</strong><span>Fields</span></div></div></div>
        </div>

        <form method="get" asp-action="Index" class="search-strip mb-3">
            <div class="search-icon"><i class="bi bi-search"></i></div>
            <input asp-for="Filters.Name" class="form-control" placeholder="Search student by name, skills, college..." />
            <select asp-for="Filters.FieldOfStudy" class="form-select">
                <option value="">All Fields</option>
                @foreach (var field in Model.FieldsOfStudy) { <option value="@field.Value">@field.Text</option> }
            </select>
            <select asp-for="Filters.JobRole" class="form-select">
                <option value="">All Roles</option>
                @foreach (var role in Model.JobRoles) { <option value="@role.Value">@role.Text</option> }
            </select>
            <button class="btn btn-gradient px-4">Search</button>
        </form>

        <div class="category-chip-row mb-3">
            <span class="fw-semibold me-2">Top Categories</span>
            <a asp-action="Index" class="chip chip-active"><i class="bi bi-grid me-1"></i>All</a>
            @foreach (var cat in Model.CategoryCounts.Take(6))
            {
                <a asp-action="Index" asp-route-fieldOfStudy="@cat.Key" class="chip"><i class="bi bi-bookmark-star me-1"></i>@cat.Key</a>
            }
        </div>

        <div class="row g-3">
            <div class="col-lg-9">
                <div id="featuredProfiles" class="d-flex justify-content-between align-items-center mb-2">
                    <h3 class="section-title-sm mb-0">Featured Student Profiles</h3>
                    <a asp-action="Profiles" class="btn btn-sm btn-outline-primary">Browse All <i class="bi bi-arrow-right"></i></a>
                </div>

                <div class="row g-3 mb-3">
                    @foreach (var p in Model.FeaturedProfiles)
                    {
                        <div class="col-md-6 col-xxl-4">
                            <article class="card profile-tile h-100 @(p.IsTopRated ? "top-rated" : string.Empty)">
                                <img src="@(p.ImagePath ?? "/images/default-avatar.svg")" class="tile-img" alt="@p.Name" />
                                <div class="card-body p-2">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="fw-bold">@p.Name</div>
                                        <span class="badge bg-warning text-dark">@p.Cgpa</span>
                                    </div>
                                    <div class="small text-muted">@p.JobRole</div>
                                    <div class="small"><i class="bi bi-geo-alt"></i> @p.Address</div>
                                    <div class="small mb-2"><i class="bi bi-building"></i> @p.CollegeName</div>
                                    <div class="d-flex gap-1 flex-wrap mb-2">
                                        <span class="skill-badge"><i class="bi bi-mortarboard me-1"></i>@p.FieldOfStudy</span>
                                        <span class="skill-badge"><i class="bi bi-briefcase me-1"></i>@p.JobRole.Split(' ').FirstOrDefault()</span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Profile" asp-route-id="@p.Id" class="btn btn-sm btn-primary flex-grow-1">View Profile</a>
                                        @if (!string.IsNullOrWhiteSpace(p.ResumePath)) { <a href="@p.ResumePath" class="btn btn-sm btn-outline-secondary" target="_blank"><i class="bi bi-download"></i></a> }
                                    </div>
                                    @if (p.IsTopRated) { <div class="mt-1"><span class="badge bg-success">Top Rated</span></div> }
                                </div>
                            </article>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-3">
                <div class="promo-gap-fill mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">Complete Your Profile</h5>
                        <i class="bi bi-three-dots text-white-50"></i>
                    </div>
                    <ul class="profile-checklist mb-3 ps-0">
                        <li><i class="bi bi-stars"></i> Add Projects <i class="bi bi-check-lg ms-auto"></i></li>
                        <li><i class="bi bi-collection"></i> Upload Certificates <i class="bi bi-check-lg ms-auto"></i></li>
                        <li><i class="bi bi-camera-video"></i> Record Video Resume <i class="bi bi-check-lg ms-auto"></i></li>
                    </ul>
                    <a asp-action="Register" class="btn btn-start w-100">Get Started <i class="bi bi-chevron-right ms-1"></i></a>
                </div>

                <div class="panel-card mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">Top Recruiters</h5>
                        <a asp-action="Profiles" class="small text-decoration-none">View All</a>
                    </div>
                    <div class="recruiter-grid">
                    @foreach (var c in Model.TopCompanies.Take(6))
                    {
                        <div class="recruiter-pill"><span>@c.Name</span><small>@c.Industry</small></div>
                    }
                    </div>
                </div>

                <div class="panel-card compact-list">
                    <h6 class="mb-2">Recent Placements</h6>
                    @foreach (var j in Model.TrendingJobs.Take(6))
                    {
                        <div class="d-flex justify-content-between border-bottom py-1"><span class="small">@j.Title</span><span class="badge bg-primary">@j.Openings</span></div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
