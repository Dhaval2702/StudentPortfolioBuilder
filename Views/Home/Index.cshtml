@model HomePageViewModel
@{
    ViewData["Title"] = "Home";
}

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["InfoMessage"] is string info)
{
    <div class="alert alert-info">@info</div>
}

<div class="row g-4 align-items-start">
    <div class="col-xl-9">
        <section class="hero-banner rounded-4 shadow-sm mb-4 p-4 p-lg-5 d-flex flex-column flex-lg-row align-items-center gap-4">
            <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=500&q=80" alt="Student working on portfolio" class="hero-image rounded-4" />
            <div>
                <h1 class="display-6 fw-bold text-primary mb-3">Build Your Student Portfolio</h1>
                <p class="lead text-muted mb-3">Create a professional portfolio to showcase your achievements and skills to potential employers.</p>
                <a asp-action="Register" class="btn btn-gradient btn-lg"><i class="bi bi-person-plus-fill me-2"></i>Get Started — Create Profile</a>
            </div>
        </section>

        <section class="mb-4">
            <h2 class="section-title">Featured Student Portfolios</h2>
            <div class="row g-3">
                @foreach (var profile in Model.FeaturedProfiles)
                {
                    <div class="col-md-6">
                        <div class="card featured-card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex gap-3">
                                    <img src="@(profile.ImagePath ?? "/images/default-avatar.svg")" alt="@profile.Name" class="featured-avatar" />
                                    <div>
                                        <h3 class="h4 fw-bold text-primary mb-1">@profile.Name</h3>
                                        <p class="mb-1"><i class="bi bi-geo-alt-fill me-1"></i>@profile.Address</p>
                                        <p class="mb-1"><i class="bi bi-mortarboard-fill me-1"></i>@profile.CollegeName</p>
                                        <p class="mb-2"><i class="bi bi-briefcase-fill me-1"></i>@profile.JobRole</p>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-white border-0 d-flex flex-wrap gap-2 align-items-center">
                                <a class="btn btn-sm btn-outline-primary" href="@profile.DegreeCertificatePath" target="_blank"><i class="bi bi-file-earmark-text me-1"></i>Degree</a>
                                <a class="btn btn-sm btn-outline-success" href="@profile.MarksheetPath" target="_blank"><i class="bi bi-journal-check me-1"></i>Marksheet</a>
                                @if (profile.HasCertifications)
                                {
                                    <a class="btn btn-sm btn-outline-warning" href="@profile.CertificationsPath" target="_blank"><i class="bi bi-patch-check me-1"></i>Certificate</a>
                                }
                                <a asp-action="Profile" asp-route-id="@profile.Id" class="btn btn-sm btn-gradient ms-auto">View Profile</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="mb-3" id="browse-profiles">
            <h2 class="section-title">Browse Student Profiles</h2>
            <form method="get" asp-action="Index" class="row g-2 mb-3">
                <div class="col-md-3">
                    <input asp-for="Filters.Name" class="form-control" placeholder="Search name..." />
                </div>
                <div class="col-md-4">
                    <select asp-for="Filters.FieldOfStudy" asp-items="Model.FieldsOfStudy" class="form-select">
                        <option value="">All Fields</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select asp-for="Filters.JobRole" asp-items="Model.JobRoles" class="form-select">
                        <option value="">All Roles</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button class="btn btn-gradient" type="submit"><i class="bi bi-search me-1"></i>Search</button>
                </div>
            </form>

            <div class="row g-3">
                @foreach (var profile in Model.BrowseProfiles)
                {
                    <div class="col-sm-6 col-lg-3">
                        <a asp-action="Profile" asp-route-id="@profile.Id" class="browse-card card border-0 shadow-sm text-decoration-none h-100">
                            <div class="card-body d-flex gap-2 align-items-center">
                                <img src="@(profile.ImagePath ?? "/images/default-avatar.svg")" alt="@profile.Name" class="browse-avatar" />
                                <div>
                                    <h3 class="h6 text-dark mb-1">@profile.Name</h3>
                                    <p class="small text-muted mb-0">@profile.JobRole</p>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 sticky-form">
            <div class="card-body">
                <h2 class="h3 text-primary fw-bold mb-3">Create Student Profile</h2>
                <form asp-action="Register" method="post" enctype="multipart/form-data" class="d-grid gap-3">
                    @Html.AntiForgeryToken()
                    <input name="Name" class="form-control" placeholder="Full Name" required />
                    <input name="Address" class="form-control" placeholder="Address" required />
                    <input name="CollegeName" class="form-control" placeholder="College Name" required />
                    <select name="FieldOfStudy" class="form-select" required>
                        <option value="">Select Field</option>
                        @foreach (var field in Model.FieldsOfStudy)
                        {
                            <option value="@field.Value">@field.Text</option>
                        }
                    </select>
                    <select name="JobRole" class="form-select" required>
                        <option value="">Select Career</option>
                        @foreach (var role in Model.JobRoles)
                        {
                            <option value="@role.Value">@role.Text</option>
                        }
                    </select>
                    <input name="Image" class="form-control" type="file" accept="image/*" />
                    <input name="Video" class="form-control" type="file" accept="video/*" />
                    <button type="submit" class="btn btn-gradient btn-lg"><i class="bi bi-check-circle-fill me-1"></i>Create Profile</button>
                </form>
            </div>
        </div>
    </div>
</div>
