@model StudentPortfolioBuilder.Models.StudentProfile
@{ ViewData["Title"] = "Profile"; }

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="row g-0">
        <div class="col-md-4 p-4 text-center profile-side text-white">
            <img src="@(Model.ImagePath ?? "/images/default-avatar.svg")" class="profile-image mb-3" alt="@Model.Name" />
            <h1 class="h3 fw-bold">@Model.Name</h1>
            <p class="mb-1">@Model.JobRole</p>
            <p class="mb-0">CGPA: @Model.Cgpa</p>
        </div>
        <div class="col-md-8 p-4 bg-white">
            <h2 class="h4 text-primary mb-3">Student Portfolio Details</h2>
            <div class="row g-2 mb-3">
                <div class="col-sm-6"><strong>Email:</strong> @(string.IsNullOrWhiteSpace(Model.Email) ? "N/A" : Model.Email)</div>
                <div class="col-sm-6"><strong>College:</strong> @Model.CollegeName</div>
                <div class="col-12"><strong>Address:</strong> @Model.Address</div>
                <div class="col-sm-6"><strong>Field:</strong> @Model.FieldOfStudy</div>
                <div class="col-sm-6"><strong>Created:</strong> @Model.CreatedOn.ToString("dd MMM yyyy")</div>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.DegreeCertificatePath)) { <a class="btn btn-outline-primary" href="@Model.DegreeCertificatePath" target="_blank">Degree</a> }
                @if (!string.IsNullOrWhiteSpace(Model.MarksheetPath)) { <a class="btn btn-outline-success" href="@Model.MarksheetPath" target="_blank">Marksheet</a> }
                @if (!string.IsNullOrWhiteSpace(Model.ResumePath)) { <a class="btn btn-outline-dark" href="@Model.ResumePath" target="_blank">CV</a> }
                @if (!string.IsNullOrWhiteSpace(Model.CertificationsPath)) { <a class="btn btn-outline-warning" href="@Model.CertificationsPath" target="_blank">Certifications</a> }
                @if (!string.IsNullOrWhiteSpace(Model.VideoPath)) { <a class="btn btn-outline-danger" href="@Model.VideoPath" target="_blank">Video Resume</a> }
            </div>

            <a asp-action="Profiles" class="btn btn-gradient"><i class="bi bi-arrow-left me-1"></i>Back to Browse Profiles</a>
        </div>
    </div>
</div>
