@model ProfileListViewModel
@{ ViewData["Title"] = "Browse Profiles"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Browse Profiles</h2>
    <span class="badge bg-primary">@Model.TotalCount Profiles</span>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input asp-for="Filters.Name" class="form-control" placeholder="Name" /></div>
    <div class="col-md-3"><input asp-for="Filters.CollegeName" class="form-control" placeholder="College" /></div>
    <div class="col-md-2"><select asp-for="Filters.FieldOfStudy" asp-items="Model.FieldsOfStudy" class="form-select"><option value="">All Fields</option></select></div>
    <div class="col-md-2"><select asp-for="Filters.JobRole" asp-items="Model.JobRoles" class="form-select"><option value="">All Roles</option></select></div>
    <div class="col-md-2"><button class="btn btn-gradient w-100">Filter</button></div>
</form>

<div class="row g-3">
@foreach (var p in Model.Profiles)
{
    <div class="col-md-6 col-xl-3">
        <div class="card profile-tile h-100 @(p.IsTopRated ? "top-rated" : string.Empty)">
            <img src="@(p.ImagePath ?? "/images/default-avatar.svg")" class="tile-img" alt="@p.Name" />
            <div class="card-body">
                <div class="fw-bold">@p.Name</div>
                <div class="small">@p.FieldOfStudy · @p.JobRole</div>
                <div class="small text-muted">CGPA @p.Cgpa</div>
                <a asp-action="Profile" asp-route-id="@p.Id" class="btn btn-sm btn-primary w-100 mt-2">View Profile</a>
            </div>
        </div>
    </div>
}
</div>

@if (Model.TotalPages > 1)
{
<nav class="mt-3"><ul class="pagination">
@for (var p = 1; p <= Model.TotalPages; p++)
{
<li class="page-item @(p==Model.CurrentPage?"active":"")">
<a class="page-link" asp-action="Profiles" asp-route-page="@p" asp-route-name="@Model.Filters.Name" asp-route-collegeName="@Model.Filters.CollegeName" asp-route-fieldOfStudy="@Model.Filters.FieldOfStudy" asp-route-jobRole="@Model.Filters.JobRole">@p</a>
</li>
}
</ul></nav>
}
