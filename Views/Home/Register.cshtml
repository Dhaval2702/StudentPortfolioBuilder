@model RegistrationViewModel
@{
    ViewData["Title"] = "Create Profile";
}

<div class="register-shell py-2 py-lg-4">
    <div class="register-card card border-0 shadow-sm mx-auto">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4 px-lg-5">
            <h1 class="h2 mb-0 fw-bold text-primary">Create Student Profile</h1>
        </div>

        <div class="register-intro px-4 px-lg-5 py-3 border-top border-bottom">
            <p class="mb-0 fs-5 text-secondary">Build your portfolio by entering your details and uploading documents and video resume.</p>
        </div>

        <div class="card-body p-4 p-lg-5 pt-3">
            <form asp-action="Register" method="post" enctype="multipart/form-data" class="create-form-layout">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="row g-3 align-items-start mb-3">
                    <div class="col-md-3 text-center">
                        <div class="avatar-placeholder mb-2">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <label for="Image" class="btn btn-gradient w-100">Upload Photo</label>
                        <input asp-for="Image" class="d-none" type="file" accept="image/*" />
                        <span asp-validation-for="Image" class="text-danger d-block small mt-1"></span>
                    </div>

                    <div class="col-md-9">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold fs-4"></label>
                            <input asp-for="Name" class="form-control form-control-lg" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold fs-4"></label>
                            <input asp-for="Email" class="form-control form-control-lg" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="Address" class="form-label fw-semibold fs-4"></label>
                            <input asp-for="Address" class="form-control form-control-lg" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="CollegeName" class="form-label fw-semibold fs-3"></label>
                    <input asp-for="CollegeName" class="form-control form-control-lg" />
                    <span asp-validation-for="CollegeName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FieldOfStudy" class="form-label fw-semibold fs-3">Select Your Career Field:</label>
                    <select asp-for="FieldOfStudy" asp-items="Model.FieldsOfStudyOptions" class="form-select form-select-lg">
                        <option value="">Computer Science</option>
                    </select>
                    <span asp-validation-for="FieldOfStudy" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="JobRole" class="form-label fw-semibold fs-3"></label>
                    <select asp-for="JobRole" asp-items="Model.JobRolesOptions" class="form-select form-select-lg">
                        <option value="">Computer Science</option>
                    </select>
                    <span asp-validation-for="JobRole" class="text-danger"></span>
                </div>

                <div class="upload-row d-flex justify-content-between align-items-center py-2 border-top">
                    <label asp-for="DegreeCertificate" class="fw-semibold fs-3 mb-0"></label>
                    <label for="DegreeCertificate" class="btn btn-gradient px-4">Upload</label>
                    <input asp-for="DegreeCertificate" class="d-none" type="file" accept=".pdf,.doc,.docx,image/*" />
                    <span asp-validation-for="DegreeCertificate" class="text-danger small"></span>
                </div>

                <div class="upload-row d-flex justify-content-between align-items-center py-2 border-top">
                    <label asp-for="Marksheet" class="fw-semibold fs-3 mb-0"></label>
                    <label for="Marksheet" class="btn btn-gradient px-4">Upload</label>
                    <input asp-for="Marksheet" class="d-none" type="file" accept=".pdf,.doc,.docx,image/*" />
                    <span asp-validation-for="Marksheet" class="text-danger small"></span>
                </div>

                <div class="upload-row d-flex justify-content-between align-items-center py-2 border-top">
                    <label asp-for="Certifications" class="fw-semibold fs-3 mb-0"></label>
                    <label for="Certifications" class="btn btn-gradient px-4">Upload</label>
                    <input asp-for="Certifications" class="d-none" type="file" accept=".pdf,.doc,.docx,image/*" />
                    <span asp-validation-for="Certifications" class="text-danger small"></span>
                </div>

                <div class="upload-row d-flex justify-content-between align-items-center py-2 border-top border-bottom mb-3">
                    <label asp-for="Video" class="fw-semibold fs-3 mb-0">Video Resume (Optional)</label>
                    <label for="Video" class="btn btn-gradient px-4">Upload</label>
                    <input asp-for="Video" class="d-none" type="file" accept="video/*" />
                    <span asp-validation-for="Video" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-gradient btn-lg px-5">Create Profile</button>
                </div>
            </form>
        </div>
    </div>
</div>
