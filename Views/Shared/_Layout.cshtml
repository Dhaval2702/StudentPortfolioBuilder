<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Portfolio</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="app-header shadow-sm sticky-top">
    <nav class="navbar navbar-expand-lg navbar-dark container py-2">
        <a class="navbar-brand fw-bold fs-3" asp-controller="Home" asp-action="Index"><i class="bi bi-mortarboard-fill me-2"></i>StudentPortfolio</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="mainNav" class="collapse navbar-collapse">
            <ul class="navbar-nav mx-auto gap-2">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="browse-profiles">Explore</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Dashboard">Jobs</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
            </ul>
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a class="btn btn-sm btn-light" asp-controller="Home" asp-action="Register">Create Portfolio</a>
                    <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Dashboard">@User.Identity?.Name</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-danger" type="submit">Logout</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-sm btn-light" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-sm btn-info text-white" asp-controller="Account" asp-action="Register">Register</a>
                }
            </div>
        </div>
    </nav>
</header>

<div class="container py-4">
    @RenderBody()
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
