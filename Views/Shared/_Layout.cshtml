<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Portfolio Builder</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="shadow-sm sticky-top">
    <nav class="navbar navbar-expand-lg navbar-dark container py-2">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Freshers Portfolio Hub</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="mainNav" class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Register">Register</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                <li class="nav-item"><a class="btn btn-sm btn-light" asp-controller="Home" asp-action="Login">Login</a></li>
                <li class="nav-item"><a class="btn btn-sm btn-warning fw-semibold" asp-controller="Home" asp-action="GoogleLogin">Login with Gmail</a></li>
            </ul>
        </div>
    </nav>
</header>

<div class="container py-4">
    @RenderBody()
</div>

<footer class="footer py-3 mt-4">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
        <small>&copy; @DateTime.Now.Year - Freshers Portfolio Hub</small>
        <div class="d-flex gap-3 small">
            <a asp-controller="Home" asp-action="Privacy" class="footer-link">Privacy Policy</a>
            <a asp-controller="Home" asp-action="Contact" class="footer-link">Contact Us</a>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
