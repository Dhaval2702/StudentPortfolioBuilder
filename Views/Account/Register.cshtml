@model StudentPortfolioBuilder.ViewModels.UserRegistrationViewModel
@{ ViewData["Title"] = "Register"; }

<div class="auth-card card mx-auto shadow-sm">
    <div class="card-body p-4">
        <h2 class="mb-3">Register</h2>
        <form asp-action="Register" method="post" enctype="multipart/form-data" class="row g-3">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-12"><input asp-for="FullName" class="form-control" placeholder="Full Name" /></div>
            <div class="col-12"><input asp-for="Email" class="form-control" placeholder="Email" /></div>
            <div class="col-md-6"><input asp-for="Password" class="form-control" placeholder="Password" /></div>
            <div class="col-md-6"><input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password" /></div>
            <div class="col-md-6"><label asp-for="ProfilePhoto" class="form-label"></label><input asp-for="ProfilePhoto" type="file" class="form-control" accept="image/*" /></div>
            <div class="col-md-6"><label asp-for="CvFile" class="form-label"></label><input asp-for="CvFile" type="file" class="form-control" accept=".pdf,.doc,.docx" /></div>
            <div class="col-md-6">
                <select asp-for="Role" class="form-select" id="roleSelect">
                    <option value="Student">Student</option>
                    <option value="HR">HR</option>
                </select>
            </div>
            <div class="col-md-6" id="companyWrap">
                <select asp-for="CompanyId" asp-items="Model.CompanyOptions" class="form-select">
                    <option value="">Select Company (for HR)</option>
                </select>
            </div>
            <div class="col-12"><button class="btn btn-gradient">Create Account</button></div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(() => {
 const role = document.getElementById('roleSelect');
 const company = document.getElementById('companyWrap');
 const sync = () => company.style.display = role.value === 'HR' ? 'block' : 'none';
 role.addEventListener('change', sync); sync();
})();
</script>
}
